        end
    end)

    return screenGui, statusLabel, barFill
end

local function failVerification(reason)
    error("Whitelist verification failed. " .. tostring(reason or ""))
end

-- ================= MAIN =================
print("Waiting for game to load...")
if not game:IsLoaded() then
    game.Loaded:Wait()
end

pcall(function()
    game:GetService("ReplicatedStorage"):WaitForChild("Modules", 10)
end)
task.wait(5)

local playersService = game:GetService("Players")
local localPlayer = playersService.LocalPlayer
if not localPlayer then
    for _ = 3, 0, -1 do
        task.wait(1)
        localPlayer = playersService.LocalPlayer
        if localPlayer then break end
    end
    if not localPlayer then
        localPlayer = playersService.PlayerAdded:Wait()
    end
end

local loadingGui, statusLabel = createLoadingScreen("Preparing BeastHub... ")
setLoadingText(statusLabel, "Preparing BeastHub... ")
task.wait(1)

setLoadingText(statusLabel, "Initializing BeastHub...")
local playerName = localPlayer.Name
pcall(function()
    task.wait(2)
end)

setLoadingText(statusLabel, "Loading required modules...")
local whitelistSource = game:HttpGet(WHITELIST_URL)
local whitelistModule = loadstringFn(whitelistSource)()

print("Checking whitelist for " .. tostring(playerName) .. "...")
local verifyFn = whitelistModule.verify
local verificationResult = verifyFn(playerName)

if type(verificationResult) ~= "table" then
    print("fail 1")
    showWhitelistMessage(localPlayer, "You are not whitelisted!\nJoin Discord to request access:")
    failVerification("fail 1")
end

setLoadingText(statusLabel, "Validating access...")
local expiryValue = verificationResult.expiry
local extraPayload = verificationResult.extraNote
if expiryValue == nil then
    print("fail 2")
    showWhitelistMessage(localPlayer, "You are not whitelisted!\nJoin Discord to request access:")
    failVerification("fail 2")
end

if type(extraPayload) ~= "string" then
    print("fail 3")
    error("Invalid whitelist response.")
end

local expiryNumber = verificationResult.expiryNum
if expiryValue ~= "lifetime" then
    if expiryNumber == nil then
        expiryNumber = tonumber(expiryValue)
    end
    local serverTime = workspace:GetServerTimeNow()
    if expiryNumber ~= nil and expiryNumber < serverTime then
        showWhitelistMessage(localPlayer, "Your whitelist access expired.")
        error("Whitelist expired for " .. tostring(playerName))
    end
end

getgenvFn()._bh_isVerified = expiryValue

setLoadingText(statusLabel, "Finalizing setup...")

local currentGameId = game.GameId
local payloadSource = nil
if currentGameId == GAME_ID_MAIN then
    payloadSource = extraPayload
elseif currentGameId == GAME_ID_ALT then
    payloadSource = verificationResult.extraNote2
end

if payloadSource ~= nil then
    local compileOk, compiledFnOrErr = pcall(function()
        return loadstringFn(payloadSource)
    end)
    if not compileOk or type(compiledFnOrErr) ~= "function" then
        error("Failed to compile: " .. tostring(compiledFnOrErr))
    end
    local runOk, runErr = pcall(compiledFnOrErr)
    if not runOk then
        warn("[BeastHub] Payload error: " .. tostring(runErr))
    end
end

setLoadingText(statusLabel, "Running security checks, please wait..")
for percent = 0, 100 do
    setLoadingText(statusLabel, "Running security checks, please wait.. " .. tostring(percent) .. "%")
    task.wait(0.01)
end
local randomDelay = math.random(5, 10)
task.wait(randomDelay)

do
    local connectivityOk = false
    pcall(function()
        connectivityOk = checkConnectivity()
    end)
end

local isAutoExecute = false
do
    local ok, queued = pcall(function()
        return (queue_on_teleport ~= nil and queue_on_teleport("", "") ~= nil)
    end)
    if _G.__bh_force_autoexec_check then
        isAutoExecute = true
    end
end
if isAutoExecute then
    showWhitelistMessage(localPlayer, "Please turn off auto-execute then rejoin")
    error("Please turn off auto-execute then rejoin")
end

destroyLoadingGui(loadingGui)
print("BeastHub loaded for " .. tostring(playerName))

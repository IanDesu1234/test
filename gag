local function sendWebhook(webhookUrl, messageText)
    if typeof(messageText) ~= "string" or messageText == "" then
        messageText = ""
    end
    if typeof(webhookUrl) ~= "string" or webhookUrl == "" then
        warn("[Webhook] Invalid webhook URL")
        return
    end
    local HttpService = game:GetService("HttpService")
    local payloadJson = HttpService:JSONEncode({ content = messageText })
    local requestFn = nil
    if syn ~= nil and syn.request then
        requestFn = syn.request
    elseif http_request ~= nil then
        requestFn = http_request
    elseif request ~= nil then
        requestFn = request
    elseif fluxus ~= nil and fluxus.request then
        requestFn = fluxus.request
    else
        warn("[Webhook] Executor does not support HTTP requests")
        return
    end
    local ok, response = pcall(function()
        return requestFn({
            Url = webhookUrl,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = payloadJson
        })
    end)
    if not ok then
        warn("[Webhook] Failed:", tostring(response))
        return
    end
    if response and response.Success == false then
        warn("[Webhook] Failed:", tostring(response.StatusCode))
    end
end

local function checkConnectivity()
    local ok, result = pcall(function()
        return game:HttpGet(CONNECTIVITY_URL)
    end)
    return ok
end


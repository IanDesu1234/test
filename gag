local function setLoadingText(statusLabel, newText)
    if statusLabel then
        statusLabel.Text = newText
    end
end

local function destroyLoadingGui(loadingGui)
    if loadingGui then
        pcall(function()
            loadingGui:Destroy()
        end)
    end
end

